# Copy to deploy/.env and fill in. deploy/.env is ignored by git.

# Shared secret between the web page proxy and the backend. Use a long random
# value, e.g. `openssl rand -hex 32`.
REACHER_SECRET=

# Exact browser origin, no trailing slash. Use HTTPS for any public deployment.
PUBLIC_ORIGIN=https://verifier-app.iqonicdesign.net
# Independent encryption key for authenticator secrets: openssl rand -hex 32.
# Keep this key backed up; changing it prevents decryption of existing 2FA secrets.
ACCOUNT_ENCRYPTION_KEY=
SECURE_COOKIES=true
# Local development only: PUBLIC_ORIGIN=http://127.0.0.1:8090, SECURE_COOKIES=false.

# Passwords for the job queue and the results database (only used between
# containers). Use long random values, e.g. `openssl rand -hex 24`.
QUEUE_PASSWORD=
DB_PASSWORD=

# Verification rate limits (protect the server's IP reputation).
MAX_PER_MINUTE=10
MAX_PER_DAY=300

# Where the web page listens on the host. Keep 127.0.0.1 unless HTTPS is
# terminated in front of it.
UI_BIND=127.0.0.1
UI_PORT=8090
