# nginx config for the Email Checker page. The nginx image fills in
# ${REACHER_SECRET} from the environment when the container starts.
server {
    listen 80;
    root /usr/share/nginx/html;

    # Everything, page and API, requires a login (see deploy/README.md).
    auth_basic "Email Checker";
    auth_basic_user_file /etc/nginx/htpasswd;

    # The page posts here. The shared secret is added server-side and is
    # never sent to the browser.
    location = /api/check {
        limit_except POST { deny all; }
        proxy_pass http://backend:8080/v1/check_email;
        proxy_set_header x-reacher-secret "${REACHER_SECRET}";
        proxy_set_header Content-Type application/json;
        proxy_read_timeout 150s;
    }
}
