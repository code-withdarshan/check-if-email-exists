# nginx config for the Email Checker page. The nginx image fills in
# ${REACHER_SECRET} from the environment when the container starts.
server {
    listen 80;
    root /usr/share/nginx/html;
    client_max_body_size 10m;

    # The backend authenticates account cookies. Login/registration assets are public.
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control "no-store" always;

    # Re-resolve the backend so a recreated container is picked up.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $reacher_upstream http://backend:8080;

    # Never grant machine-API access to browser requests or forward a client-supplied key.
    proxy_set_header x-reacher-secret "";
    # This separate secret authenticates only the proxy's client-IP metadata.
    proxy_set_header x-reacher-proxy-secret "${REACHER_SECRET}";
    proxy_set_header x-reacher-client-ip $remote_addr;
    proxy_read_timeout 150s;

    location = /api/check {
        limit_except POST { deny all; }
        rewrite ^ /v1/check_email break;
        proxy_pass $reacher_upstream;
    }
    location = /api/bulk {
        limit_except POST { deny all; }
        rewrite ^ /v1/bulk break;
        proxy_pass $reacher_upstream;
    }
    location ~ ^/api/bulk/[0-9]+(/results)?$ {
        limit_except GET { deny all; }
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $reacher_upstream;
    }
    location = /api/usage {
        limit_except GET { deny all; }
        rewrite ^ /v1/usage break;
        proxy_pass $reacher_upstream;
    }
    location ~ ^/api/account/([a-z0-9-]+)$ {
        limit_except GET POST { deny all; }
        rewrite ^/api/(.*)$ /v1/$1 break;
        proxy_pass $reacher_upstream;
    }
}
